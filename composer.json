{
    "name": "poncho/admin-bundle",
    "type": "symfony-bundle",
    "description": "Poncho Admin Symfony bundle.",
    "keywords": [
        "backend",
        "admin",
        "poncho"
    ],
    "homepage": "https://github.com/beaumu/poncho-admin-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Beau Muylle",
            "email": "poncho-admin@beaumuylle.be"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.3.2,<3.7.0",
        "knplabs/knp-time-bundle": "^2.4",
        "symfony/asset": "^8.1",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/maker-bundle": "^1.36",
        "symfony/mime": "^8.1",
        "symfony/options-resolver": "^8.1",
        "symfony/password-hasher": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/security-csrf": "^8.1",
        "symfony/security-http": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/var-exporter": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^8.1",
        "doctrine/doctrine-fixtures-bundle": "^4.0.0",
        "friendsofphp/php-cs-fixer": "^3.70",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "Poncho\\AdminBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Poncho\\AdminBundle\\Tests\\": "tests/",
            "Poncho\\AdminBundle\\Tests\\App\\": "tests/App/src/"
        }
    }
}
