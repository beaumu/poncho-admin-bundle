{% extends "@PonchoAdmin/email/layout.html.twig" %}

{% trans_default_domain 'PonchoAdmin' %}
{% block content %}
    {{ 'password_resetting.email.body' | trans({
        '%name%': user.getFullName(),
        '%app_name%': poncho_admin.appName(),
        '%reset_url%': url('poncho_admin_security_passwordreset', {token: token})
    }) | raw }}
{% endblock %}